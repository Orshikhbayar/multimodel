# ============================================================
# MultiModel AI Environment Variables
# ============================================================
#
# Copy this file to .env.local and fill in the values
#
# SECURITY NOTES:
# - NEVER commit .env.local to version control
# - API keys (non NEXT_PUBLIC_*) are server-side only
# - NEXT_PUBLIC_* variables are exposed to the browser
#
# LEGEND:
# [REQUIRED]     - Must be set for the app to work
# [PRODUCTION]   - Required for production deployment
# [OPTIONAL]     - Nice to have, app works without it
#
# ============================================================

# ======================
# LLM Provider API Keys (SERVER-SIDE ONLY)
# ======================

# [REQUIRED] OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# [OPTIONAL] Additional providers (uncomment to enable)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# GOOGLE_AI_API_KEY=your-google-ai-key-here
# XAI_API_KEY=your-xai-key-here
# DEEPSEEK_API_KEY=your-deepseek-key-here

# ======================
# Authentication
# ======================

# [REQUIRED] NextAuth secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# [PRODUCTION] OAuth Providers (at least one required for production)
# Google OAuth - https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ======================
# Database
# ======================

# [PRODUCTION] PostgreSQL connection string
# For local development with Docker:
#   docker run --name multimodel-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
#   docker exec multimodel-postgres psql -U postgres -c "CREATE DATABASE multimodel_ai;"
#
# Example local URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodel_ai
#
# For cloud providers (Vercel Postgres, Neon, Supabase, Railway):
# Use their provided connection string
DATABASE_URL=

# [OPTIONAL] Direct connection URL for migrations (serverless environments)
# Some providers require a separate non-pooled connection for migrations
# DIRECT_URL=postgresql://user:password@host:5432/database

# ======================
# Application Settings
# ======================

# [PRODUCTION] Base URL for the app (used for OAuth callbacks)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPTIONAL] Enable debug mode (logs analytics events to console)
NEXT_PUBLIC_DEBUG=false

# [OPTIONAL] Node environment
# NODE_ENV=development

# ======================
# Observability
# ======================

# [OPTIONAL] Sentry Error Tracking
# Get your DSN at: https://sentry.io/
# Server-side DSN (API routes, server components)
# SENTRY_DSN=https://xxx@o123456.ingest.sentry.io/123456
# Client-side DSN (browser errors)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123456.ingest.sentry.io/123456

# [OPTIONAL] Sentry source map upload (improves error stack traces in production)
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=your-auth-token

# ======================
# Quick Start Checklist
# ======================
# Development:
#   1. Set OPENAI_API_KEY
#   2. Set AUTH_SECRET (any random string for dev)
#   3. Run: npm run dev
#
# Production:
#   1. Set OPENAI_API_KEY
#   2. Set AUTH_SECRET (use: openssl rand -base64 32)
#   3. Set DATABASE_URL (PostgreSQL connection string)
#   4. Set NEXT_PUBLIC_APP_URL (your production URL)
#   5. Set OAuth provider credentials (Google or GitHub)
#   6. Run: npx prisma migrate deploy && npm run build && npm start
