# ============================================================
# MultiModel AI Environment Variables
# ============================================================
#
# Copy this file to .env.local and fill in the values
#
# SECURITY NOTES:
# - NEVER commit .env.local to version control
# - API keys (non NEXT_PUBLIC_*) are server-side only
# - NEXT_PUBLIC_* variables are exposed to the browser
#
# LEGEND:
# [REQUIRED]     - Must be set for the app to work
# [PRODUCTION]   - Required for production deployment
# [OPTIONAL]     - Nice to have, app works without it
#
# ============================================================

# ======================
# LLM Provider API Keys (SERVER-SIDE ONLY)
# ======================

# [REQUIRED] OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# [OPTIONAL] Additional providers (uncomment to enable)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# GOOGLE_AI_API_KEY=your-google-ai-key-here
# XAI_API_KEY=your-xai-key-here
# DEEPSEEK_API_KEY=your-deepseek-key-here

# ======================
# Supabase Auth + Database
# ======================

# [REQUIRED] Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# [REQUIRED] Supabase publishable key (or anon key for legacy projects)
# Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY can be used as fallback for older setups.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [SERVER-ONLY] Service role key for admin/migration scripts only.
# Never use this key in client-side code or normal user data operations.
SUPABASE_SERVICE_ROLE_KEY=

# ======================
# Application Settings
# ======================

# [PRODUCTION] Base URL for the app (used for magic-link callbacks)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPTIONAL] Enable debug mode (logs analytics events to console)
NEXT_PUBLIC_DEBUG=false

# [OPTIONAL] Test/E2E bypass flags (never enable in production)
# E2E_AUTH_BYPASS=true
# NEXT_PUBLIC_E2E_BYPASS=true
# NEXT_PUBLIC_DISABLE_SERVER_BILLING=true

# [OPTIONAL] Unlimited tester/admin emails (comma-separated list)
# No hardcoded fallback is used; set one of these to enable unlimited tester access.
# ADMIN_EMAIL=orshikhbayar@gmail.com
# UNLIMITED_TESTER_EMAILS=orshikhbayar@gmail.com

# [OPTIONAL] Node environment
# NODE_ENV=development

# ======================
# Observability
# ======================

# [OPTIONAL] Sentry Error Tracking
# Get your DSN at: https://sentry.io/
# Server-side DSN (API routes, server components)
# SENTRY_DSN=https://xxx@o123456.ingest.sentry.io/123456
# Client-side DSN (browser errors)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123456.ingest.sentry.io/123456

# [OPTIONAL] Sentry source map upload (improves error stack traces in production)
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=your-auth-token

# ======================
# Quick Start Checklist
# ======================
# Development:
#   1. Set OPENAI_API_KEY
#   2. Set NEXT_PUBLIC_SUPABASE_URL
#   3. Set NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   3. Run: npm run dev
#
# Production:
#   1. Set OPENAI_API_KEY
#   2. Set NEXT_PUBLIC_SUPABASE_URL
#   3. Set NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   4. Set SUPABASE_SERVICE_ROLE_KEY
#   5. Set NEXT_PUBLIC_APP_URL (your production URL)
#   6. Run: supabase db push && npm run build && npm start
