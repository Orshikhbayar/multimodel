    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@tanstack/react-virtual": "^3.13.18",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "nanoid": "^5.0.7",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
