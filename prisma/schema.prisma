// Prisma schema for Multi-Model AI Chat Application
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// NextAuth.js Models (for authentication)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  planId               String   @default("free")
  billingCadence       String   @default("monthly")
  billingCurrency      String   @default("USD")
  periodStartAt        DateTime @default(now())
  periodEndAt          DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '1 month')"))
  includedCreditsCents Int      @default(0)
  topUpCreditsCents    Int      @default(0)

  // Relations
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  conversations Conversation[]
  usageRecords  UsageRecord[]
  billingTransactions BillingTransaction[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Application Models
// ============================================

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([userId])
  @@map("projects")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
  @@index([projectId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "assistant" | "system"
  content        String   @db.Text
  createdAt      DateTime @default(now())
  editedAt       DateTime?

  // Optional JSON fields for attachments and tool calls
  attachments Json? // Array of Attachment objects
  toolCalls   Json? // Array of ToolCall objects

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runs         Run[]

  @@index([conversationId])
  @@map("messages")
}

model Run {
  id        String   @id @default(cuid())
  messageId String
  model     String   // Model identifier (e.g., "openai/gpt-4o")
  slotId    String?  // UI slot identifier
  status    String   // "streaming" | "done" | "error"
  text      String   @db.Text
  
  // Metadata
  interrupted Boolean @default(false)
  sources     Json?   // Array of Source objects
  disagreements Json? // Array of Disagreement objects
  
  // Token usage
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  
  // Performance
  latencyMs Int?
  
  // Error info
  errorMessage String?
  errorCode    String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  message     Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  usageRecord UsageRecord?

  @@index([messageId])
  @@map("runs")
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  runId     String?  @unique
  
  // Usage data
  model            String
  provider         String?
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCostUsd Float
  
  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  Run? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("usage_records")
}

model BillingTransaction {
  id               String   @id @default(cuid())
  userId           String
  type             String
  amountPaidCents  Int
  creditDeltaCents Int
  balanceAfterCents Int
  currency         String
  referenceId      String?
  metadata         Json?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([referenceId])
  @@map("billing_transactions")
}
